(require :asdf)
(asdf:load-system :lightfast)
(lightfast:load-library)

;;; A canvas draws with the primitives a custom-drawn interface needs, and the
;;; offscreen capture shows what each of them put on the paper.

(defun read-ppm (path)
  "Return the width, height and pixel octets of the binary PPM at PATH."
  (with-open-file (in path :element-type '(unsigned-byte 8))
    (labels ((token ()
               (let ((characters nil))
                 (loop for octet = (read-byte in)
                       until (member octet '(9 10 13 32))
                       do (push (code-char octet) characters))
                 (coerce (nreverse characters) 'string))))
      (assert (string= (token) "P6"))
      (let* ((width  (parse-integer (token)))
             (height (parse-integer (token)))
             (pixels (make-array (* 3 width height) :element-type '(unsigned-byte 8))))
        (token)
        (read-sequence pixels in)
        (values width height pixels)))))

(defun write-ppm (path width height red green blue)
  "Write a WIDTH by HEIGHT binary PPM of one color at PATH."
  (with-open-file (out path :element-type '(unsigned-byte 8) :direction :output :if-exists :supersede)
    (loop for character across (format nil "P6~%~D ~D~%255~%" width height)
          do (write-byte (char-code character) out))
    (dotimes (index (* width height))
      (write-byte red out)
      (write-byte green out)
      (write-byte blue out))))

(let* ((directory (uiop:ensure-directory-pathname
                   (or (uiop:getenv "LIGHTFAST_SMOKE_DIRECTORY")
                       (merge-pathnames "build/" (asdf:system-source-directory :lightfast)))))
       (tile-path (merge-pathnames "smoke-canvas-tile.ppm" directory))
       (shot-path (merge-pathnames "smoke-canvas.ppm" directory))
       (window    (lightfast:make-window :width 240 :height 160 :label "canvas"))
       (image     nil)
       (clip      nil)
       (canvas    nil))
  (ensure-directories-exist directory)
  (write-ppm tile-path 8 6 200 30 30)
  (assert (null (lightfast:load-image (merge-pathnames "no-such-image.png" directory))) ()
          "a missing image loaded")
  (setf image (lightfast:load-image tile-path))
  (assert image () "the test image did not load")
  (assert (equal (multiple-value-list (lightfast:image-size image)) '(8 6)))
  (lightfast:with-parent (window)
    (setf canvas (lightfast:make-canvas
                  :x 0 :y 0 :width 240 :height 160
                  :callback
                  (lambda (widget event value)
                    (declare (ignore widget event value))
                    (setf clip (multiple-value-list (lightfast:draw-clip-box 0 0 240 160)))
                    (lightfast:draw-color-rgb :red 255 :green 254 :blue 250)
                    (lightfast:draw-filled-rect 0 0 240 160)
                    (lightfast:draw-dither 10 10 60 60 :step 3)
                    (lightfast:draw-color-rgb :red 0 :green 0 :blue 0)
                    (lightfast:draw-polygon '(100 10 160 10 130 70) :filled t)
                    (lightfast:draw-line-style :width 3)
                    (lightfast:draw-line 10 100 110 100)
                    (lightfast:draw-line-style)
                    (lightfast:draw-polygon '(180 10 230 10 230 60 180 60))
                    (lightfast:draw-image image 180 100 :width 40 :height 30)))))
  (lightfast:set-box canvas lightfast:+box-flat-box+)
  (lightfast:canvas-set-focusable canvas nil)
  (lightfast:set-placeholder (lightfast:make-input :parent window :x 0 :y 140 :width 1 :height 1) "x")
  (lightfast:show window)
  (lightfast:wait 0.2)
  (lightfast:capture-window window shot-path)
  (assert (and clip (fifth clip)) () "the draw callback saw no clip box")
  (multiple-value-bind (width height pixels) (read-ppm shot-path)
    ;; A tiling compositor sizes the window itself; the canvas keeps its box.
    (let ((scale (/ width (lightfast:widget-width (lightfast:refresh-geometry window)))))
      (flet ((pixel (x y)
               (let ((offset (* 3 (+ (* (round (* y scale)) width) (round (* x scale))))))
                 (list (aref pixels offset) (aref pixels (+ offset 1)) (aref pixels (+ offset 2)))))
             (dark-p (color)
               (< (reduce #'+ color) 120)))
        (declare (ignorable height))
        ;; The dither holds both ink dots and bare paper.
        (let ((dark 0) (light 0))
          (loop for y from 12 below 66
                do (loop for x from 12 below 66
                         do (if (dark-p (pixel x y)) (incf dark) (incf light))))
          (assert (and (plusp dark) (> light dark)) ()
                  "dither drew ~D dark and ~D light pixels" dark light))
        (assert (dark-p (pixel 130 30)) () "the filled polygon is not ink")
        (assert (dark-p (pixel 60 100)) () "the thick line is not ink")
        (assert (not (dark-p (pixel 205 35))) () "the outlined polygon was filled")
        (destructuring-bind (red green blue) (pixel 200 115)
          (assert (and (> red 150) (< green 90) (< blue 90)) ()
                  "the image drew ~D ~D ~D" red green blue)))))
  (lightfast:release-image image)
  (lightfast:destroy window)
  (format t "~&canvas smoke passed~%"))
