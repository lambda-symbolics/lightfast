(require :asdf)
(asdf:load-system :lightfast)
(lightfast:load-library)

;; An application's own font file: registered for this process alone, then
;; listed and loaded like an installed face. LIGHTFAST_SMOKE_FONT and
;; LIGHTFAST_SMOKE_FONT_FAMILY name another file and its family.
(let* ((fixtures (merge-pathnames "tests/fixtures/" (asdf:system-source-directory :lightfast)))
       (path (or (uiop:getenvp "LIGHTFAST_SMOKE_FONT")
                 (merge-pathnames "cmu-typewriter-regular.ttf" fixtures)))
       (family (or (uiop:getenvp "LIGHTFAST_SMOKE_FONT_FAMILY") "CMU Typewriter Text"))
       (sample "Lightfast iiii WWWW 0123"))
  (assert (not (lightfast:register-font-file (merge-pathnames "no-such-font.ttf" fixtures))) ()
          "a missing font file registered")
  (assert (not (lightfast:register-font-file (merge-pathnames "cmu-typewriter-OFL.txt" fixtures))) ()
          "a text file registered as a font")
  (assert (lightfast:register-font-file path) () "~A did not register" path)
  (assert (lightfast:register-font-file path) () "registering ~A again failed" path)
  (multiple-value-bind (all refused)
      (lightfast:register-font-files (list path (merge-pathnames "no-such-font.ttf" fixtures)))
    (assert (and (not all) (= 1 (length refused))) () "the refused files are ~S" refused))
  (assert (find (truename path) (lightfast:font-files family)
                :key (lambda (entry) (truename (car entry))) :test #'equal)
          () "~A is not among the files of ~A: ~S" path family (lightfast:font-files family))
  (assert (find-if (lambda (entry) (search family (car entry))) (lightfast:system-font-names)) ()
          "~A is not listed among the system's faces" family)
  ;; A name no font answers to gets the fallback face; the registered family
  ;; must measure differently from that.
  (let ((fallback (lightfast:measure-text sample :font (lightfast:load-font "Lightfast No Such Face")
                                                 :size 20))
        (registered (lightfast:measure-text sample :font (lightfast:load-font family) :size 20)))
    (assert (/= fallback registered) ()
            "~A measures ~D px, the same as the fallback face" family registered)
    (format t "~&Registered ~A: ~D px against ~D px in the fallback face.~%"
            family registered fallback)))

(let* ((names (lightfast:system-font-names))
       (first-name (first (first names)))
       (font (lightfast:load-font first-name))
       (again (lightfast:load-font first-name)))
  (assert (plusp (length names)) () "no system fonts enumerated")
  (assert (= font again) () "loading the same face twice gave two numbers")
  (assert (string= (lightfast:font-name font) first-name))
  (multiple-value-bind (width height descent)
      (lightfast:measure-text "Lightfast" :font font :size 16)
    (assert (plusp width))
    (assert (plusp height))
    (assert (<= 0 descent height))
    (multiple-value-bind (wider) (lightfast:measure-text "Lightfast Lightfast" :font font :size 16)
      (assert (> wider width))))
  ;; A tall label and a short button in one row meet on their baselines after
  ;; ALIGN-BASELINES, whatever their heights and sizes.
  (lightfast:apply-flat-theme)
  (let* ((window (lightfast:make-window :width 400 :height 100 :label "baselines"))
         (title (lightfast:make-label :parent window :x 10 :y 10 :width 150 :height 40 :label "Title"))
         (button (lightfast:make-button :parent window :x 170 :y 10 :width 100 :height 30 :label "Button")))
    (lightfast:set-label-size title 28)
    (lightfast:set-label-size button 14)
    (lightfast:align-baselines (list title button))
    (lightfast:refresh-geometry title)
    (lightfast:refresh-geometry button)
    (assert (= (+ (lightfast:widget-y title) (lightfast:widget-baseline title))
               (+ (lightfast:widget-y button) (lightfast:widget-baseline button)))
            () "baselines differ after alignment")
    (lightfast:destroy window))
  (format t "~&Lightfast font smoke passed with ~D faces; first is ~S.~%" (length names) first-name))

;; Folding a line gap keeps every byte but the metrics and checksums, and the
;; copy reads back with zero gaps.
(let* ((gapped (loop for (name) in (lightfast:system-font-names)
                     for files = (lightfast:font-files name)
                     for file = (car (first files))
                     when (and file (lightfast:font-line-gaps file)
                               (/= 0 (lightfast:font-line-gaps file)))
                       return file)))
  (if gapped
      (let ((copy (namestring (uiop:xdg-cache-home "lightfast/smoke/" (file-namestring gapped)))))
        (assert (lightfast:fold-font-line-gap gapped copy))
        (multiple-value-bind (hhea typo) (lightfast:font-line-gaps copy)
          (assert (= 0 hhea) () "hhea gap ~D remains after folding" hhea)
          (assert (or (null typo) (= 0 typo)) () "typographic gap ~D remains after folding" typo))
        (format t "~&Folded the line gap of ~A.~%" gapped))
      (format t "~&No installed font carries a line gap; folding not exercised.~%")))
